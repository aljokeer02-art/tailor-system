# انسخ هذا الملف باسم .env وضع فيه بياناتك الفعلية (الملف .env لا يُرفع لـ GitHub)

# رابط اتصال قاعدة بيانات Supabase Postgres — من Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres

# بريد وكلمة مرور حساب المدير الأول (يُنشأ تلقائياً عند أول تشغيل إن لم توجد مستخدمون)
ADMIN_EMAIL=alsaadamr94@gmail.com
ADMIN_DEFAULT_PASSWORD=Tailor@2026

# نص عشوائي طويل لتوقيع جلسات الدخول (JWT) — غيّره لقيمة خاصة بك
JWT_SECRET=change-this-to-a-long-random-string

# منفذ التشغيل المحلي (اختياري)
PORT=4000
